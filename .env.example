# club5to7 · environment variables
# Copy to .env and fill in. Nothing here is loaded at runtime in the
# prototype (no build step) — these names are documented so the
# developer wiring the real backend knows what to expect.

# ── Supabase ─────────────────────────────────────────────────
# Create a project at supabase.com, then find these in
# Project Settings → API.
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_ANON_KEY="eyJh…"     # the "anon / public" key, not the service role

# ── Chapa payments ───────────────────────────────────────────
# Sign up at chapa.co, generate a test key first. Switch to live
# when you flip the feature flag.
CHAPA_PUBLIC_KEY="CHAPUBK_TEST-XXXXX"
CHAPA_SECRET_KEY="CHASECK_TEST-XXXXX"

# ── Admin gate ───────────────────────────────────────────────
# Temporary while there's no real auth. Once Supabase auth is wired,
# this becomes irrelevant.
ADMIN_PASSWORD="change-me"

# ── Site ─────────────────────────────────────────────────────
SITE_URL="https://club5to7.xyz"
